`),i<t.length&&(s+=String(t[i]??""));return s.replace(/^\n/,"").replace(/\n[ \t]*$/,"")}const gh="/*EDITMODE-BEGIN*/",P$="/*EDITMODE-END*/";function $$(e){const t=e.indexOf(gh);if(t===-1)return null;const n=e.indexOf(P$,t);if(n===-1)return null;const r=t+gh.length;return r>=n?null:{start:r,end:n}}function Qae(e,t){const n=$$(e);if(!n)throw new Error("No EDITMODE-BEGIN/END markers found");const r=e.slice(n.start,n.end);let s;try{s=JSON.parse(r)}catch(f){throw new Error(`EDITMODE block is not valid JSON: ${f instanceof Error?f.message:f}`)}if(s==null||typeof s!="object"||Array.isArray(s))throw new Error("EDITMODE block must be a JSON object");const i={...s,...t},a=e.lastIndexOf(`
`,n.start-gh.length)+1,c=e.slice(a,n.start-gh.length).match(/^[ \t]*/),d=c?c[0]:"",h=JSON.stringify(i,null,2).replace(/</g,"\\u003c").replace(/\//g,"\\/").split(`
