    html = html.replace(/<([A-Z][A-Za-z0-9]*)/g, (_, n) => '<sc-comp sc-name="' + n + '"');
    html = html.replace(/<\\/([A-Z][A-Za-z0-9]*)\\s*>/g, '</sc-comp>');
    // onClick= → sc-camel-on-click=   (any attr containing an uppercase letter)
    html = html.replace(
      /(\\s)([a-z]+[A-Z][A-Za-z0-9]*)(\\s*=)/g,
