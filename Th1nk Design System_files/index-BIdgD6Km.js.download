  // ─────────────────────── interpolation expression eval ───────────────────
  // Tiny inline interpreter for \`{{ user.tags[0] === "admin" }}\` style holes.
  // Supports: identifier + dotted property + bracket subscription chains,
  // equality (==/!=/===/!==), prefix \`!\`, parenthesised grouping, and the
  // JSON-ish literals (numbers, strings, true/false/null/undefined). No
  // arithmetic, no logical &&/||, no <,>, no calls. Parse failures and
  // missing-path lookups both return undefined so a partially-arrived
  // mid-stream expression can't crash the surrounding render — the
  // text-walker's missing-val placeholder takes over.
  //
  // No \`eval\` / \`new Function\` — templates stream char-by-char from the
  // model, so feeding them to a JS runtime would (a) bypass CSP, (b) leak
  // the surrounding scope, and (c) let a malformed mid-stream expression
  // run real JS. Resist growing this — anything you can't express here
  // belongs in \`renderVals()\`, where it's a regular JS expression in
  // logic-land.
  //
  // Walks the source string directly. Templates are small enough that
  // re-walking per render is cheap; no AST cache, no tokenizer.
  function resolve(vals, src) {
    const expr = String(src).trim();
    if (!expr) return undefined;
    // ( … ) — strip outer parens iff they wrap the whole expression
    if (expr[0] === '(' && expr[expr.length - 1] === ')') {
      let d = 0,
