    const head = expr.match(/^[A-Za-z_$][A-Za-z0-9_$]*/);
    if (!head) return undefined;
    let cur = vals == null ? undefined : vals[head[0]];
    let i = head[0].length;
    while (i < expr.length) {
      if (expr[i] === '.') {
        const m = expr.slice(i + 1).match(/^[A-Za-z_$][A-Za-z0-9_$]*/);
        if (!m) return undefined;
        cur = cur == null ? undefined : cur[m[0]];
        i += 1 + m[0].length;
      } else if (expr[i] === '[') {
        // find matching ] at the same depth
        let d = 1,
          j = i + 1;
        while (j < expr.length && d > 0) {
          if (expr[j] === '[') d++;
          else if (expr[j] === ']') {
            d--;
            if (d === 0) break;
          }
          j++;
        }
        if (d !== 0) return undefined;
        const key = resolve(vals, expr.slice(i + 1, j));
        cur = cur == null ? undefined : cur[key];
        i = j + 1;
      } else {
        return undefined;
      }
